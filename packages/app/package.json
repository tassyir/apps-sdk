{
  "name": "@tassyir/app",
  "version": "0.0.0",
  "description": "Server SDK for Tassyir apps: token exchange and refresh, ID-token and webhook verification, and a typed Admin API client.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tassyir/apps-sdk.git",
    "directory": "packages/app"
  },
  "homepage": "https://github.com/tassyir/apps-sdk/tree/main/packages/app#readme",
  "keywords": [
    "tassyir",
    "tassyir-app",
    "oauth",
    "webhooks",
    "standard-webhooks",
    "ed25519",
    "openapi"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "openapi:check": "node scripts/openapi.mjs check",
    "openapi:update": "node scripts/openapi.mjs update",
    "openapi:generate": "node scripts/openapi.mjs generate",
    "vectors:generate": "node scripts/generate-vectors.mjs"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0"
  }
}
