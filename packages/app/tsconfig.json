{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The library runs on Node 22 and on Workers-like runtimes: it is typed
    // against the web platform (fetch, WebCrypto). Specs and scripts also run
    // on Node; eslint.config.mjs keeps Node built-ins out of the library code.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": true
  },
  "include": ["src", "scripts", "tsdown.config.ts"]
}
