{
  "name": "@tassyir/app-manifest",
  "version": "0.1.1",
  "description": "Schema and validator for tassyir.app.toml, the Tassyir app manifest: the normalised manifest or every error with a code, a path and a fix.",
  "keywords": [
    "tassyir",
    "manifest",
    "validator",
    "json-schema"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tassyir/apps-sdk.git",
    "directory": "packages/app-manifest"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./schemas/manifest.2026-10.schema.json": "./schemas/manifest.2026-10.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "schemas": "vitest run --root ../.. packages/app-manifest/src/json-schema.test.ts --update",
    "parity": "tsdown && vitest run --root ../.. packages/app-manifest/src/backend-parity.test.ts"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
