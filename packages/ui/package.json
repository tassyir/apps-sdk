{
  "name": "@tassyir/ui",
  "version": "0.1.0",
  "description": "Web components for Tassyir app pages: the dashboard's look (ink-on-paper tokens, right-to-left, dark mode) as custom elements that work in any framework or none.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tassyir/apps-sdk.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/tassyir/apps-sdk/tree/main/packages/ui#readme",
  "keywords": [
    "tassyir",
    "tassyir-app",
    "web-components",
    "custom-elements",
    "design-system",
    "rtl",
    "dark-mode"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/index.js",
    "./dist/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./tokens": {
      "import": {
        "types": "./dist/tokens.d.ts",
        "default": "./dist/tokens.js"
      }
    },
    "./tokens.css": "./dist/tokens.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && node scripts/tokens-css.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "parity": "vitest run --root ../.. packages/ui/src/frontend-parity.test.ts",
    "size": "node scripts/size.mjs",
    "demo": "node scripts/demo-server.mjs",
    "browser-check": "node scripts/browser-check.mjs"
  }
}
