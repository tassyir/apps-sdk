# Copy to .env with `npm run setup` (it also makes TOKEN_STORE_KEY). Never
# commit .env. The values come from the developer console:
# https://app.tassyir.io/en/developers, then your app.

# Credentials: the client ID, and a client secret (shown once when created).
TASSYIR_CLIENT_ID=app_your-client-id
TASSYIR_CLIENT_SECRET=tsy_cs_your-client-secret

# The app's numeric id: the number at the end of the app's address in the
# console (/developers/apps/<id>). Webhooks name it; it is not the client ID.
TASSYIR_APP_ID=your-app-id

# 32 random bytes in base64 that encrypt the stored tokens.
TOKEN_STORE_KEY=your-token-store-key

# Optional.
# PORT=3000
# DATA_DIR=data
