{
  "name": "my-tassyir-app",
  "version": "0.1.0",
  "private": true,
  "description": "A Tassyir app on Tassyir Hosting: a Cloudflare Worker (Hono) with a React page inside the Tassyir dashboard, its own SQLite storage and the Admin API.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "validate": "node scripts/validate.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && tsc -p src/page/tsconfig.json",
    "test": "vitest run",
    "deploy:check": "npm run build && tassyir deploy --dry-run",
    "deploy": "npm run build && tassyir deploy",
    "check": "npm run validate && npm run typecheck && npm test && npm run deploy:check"
  },
  "dependencies": {
    "@tassyir/app": "*",
    "@tassyir/app-bridge": "*",
    "@tassyir/ui": "*",
    "hono": "4.13.11",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.4",
    "@cloudflare/workers-types": "5.20260930.2",
    "@tassyir/app-manifest": "*",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/runner": "4.1.11",
    "@vitest/snapshot": "4.1.11",
    "esbuild": "0.28.2",
    "smol-toml": "1.9.0",
    "tassyir": "*",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
