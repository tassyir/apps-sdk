{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    // Typecheck and lint against @tassyir/app-manifest's source: its dist/
    // only exists after `npm run build`, which runs after both. The build
    // and the published package use the real dependency.
    "paths": {
      "@tassyir/app-manifest": ["../app-manifest/src/index.ts"]
    }
  },
  "include": ["src", "tsdown.config.ts"]
}
