{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "types": ["node"],
    // scripts/docs-site.mjs reads @tassyir/ui's colour tokens from their
    // source (Node 22.18 strips the types), so the site needs no build.
    "allowImportingTsExtensions": true,
    // scripts/guides.test.mjs validates the guides' manifests with
    // @tassyir/app-manifest and their Liquid and CSS samples with
    // @tassyir/storefront-blocks: typecheck it against the packages' source,
    // as vitest.config.ts runs it (dist/ only exists after `npm run build`).
    "paths": {
      "@tassyir/app-manifest": ["./packages/app-manifest/src/index.ts"],
      "@tassyir/storefront-blocks": [
        "./packages/storefront-blocks/src/index.ts"
      ]
    }
  },
  "include": ["scripts", "eslint.config.mjs", "vitest.config.ts"]
}
